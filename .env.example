# Copia este archivo como .env en el servidor y completa los valores.
# El .env real nunca se sube a Git (está en .gitignore).

# Lectura de portadas con IA (api/estanteria-routes.js) — basta con UNA clave
# Gratis: https://openrouter.ai/keys (20 lecturas/min, 50/día; 1000/día con ≥ 10 USD comprados)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=amazon/nova-2-lite-v1:free,openrouter/free
# De pago (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# auto = OpenRouter primero y Claude de respaldo · openrouter · anthropic
IA_PROVEEDOR=auto

# Fotos de portada y contraportada
PORTADAS_DIR=/app/portadas
PORTADAS_URL=/portadas
